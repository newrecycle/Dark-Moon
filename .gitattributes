# Normalize line endings for all text files
* text=auto

# Force Unix line endings for shell scripts and config
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env text eol=lf

# Binary files
*.pyc binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.whl binary
