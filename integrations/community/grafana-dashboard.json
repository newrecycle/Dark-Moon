{
  "uid": "darkmoon-community",
  "title": "DarkMoon Community",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": [{"name":"datasource","label":"Prometheus","type":"datasource","query":"prometheus","current":{}}]},
  "panels": [
    {"id":1,"title":"Findings by severity","type":"barchart","datasource":{"type":"prometheus","uid":"${datasource}"},"gridPos":{"x":0,"y":0,"w":12,"h":9},"targets":[{"expr":"darkmoon_findings","legendFormat":"{{severity}}","refId":"A","instant":true}]},
    {"id":2,"title":"Assessments","type":"stat","datasource":{"type":"prometheus","uid":"${datasource}"},"gridPos":{"x":12,"y":0,"w":6,"h":5},"targets":[{"expr":"darkmoon_campaigns","refId":"A","instant":true}]},
    {"id":3,"title":"Queued / running jobs","type":"stat","datasource":{"type":"prometheus","uid":"${datasource}"},"gridPos":{"x":18,"y":0,"w":6,"h":5},"targets":[{"expr":"darkmoon_jobs_active","refId":"A","instant":true}]}
  ]
}
