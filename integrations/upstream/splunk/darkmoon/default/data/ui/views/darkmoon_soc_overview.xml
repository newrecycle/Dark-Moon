<form version="1.1" theme="dark">
  <label>Darkmoon — SOC Overview</label>
  <description>Latest observed metadata within the selected source-time window. Accepted and unknown states remain open. These snapshots do not establish live exploit validation, deployment or complete retained-workspace coverage.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="proj" searchWhenChanged="true">
      <label>Project</label>
      <choice value="*">All projects</choice>
      <default>*</default>
      <fieldForLabel>project_id</fieldForLabel>
      <fieldForValue>project_id</fieldForValue>
      <search>
        <query>`darkmoon_findings` | stats count by project_id | sort project_id</query>
        <earliest>$tr.earliest$</earliest>
        <latest>$tr.latest$</latest>
      </search>
    </input>
  </fieldset>

  <row>
    <panel>
      <title>Active campaigns</title>
      <single>
        <search>
          <query>`darkmoon_campaigns` project_id=$proj|s$ | dedup campaign_id sortby -_indextime -_time | where status="running" | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf8be34"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Critical (open)</title>
      <single>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search severity=critical | search NOT status IN ("false_positive","remediated","resolved","closed","fixed") | stats dc(finding_key)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
        <drilldown>
          <link target="_blank">darkmoon_findings?form.sev=critical&amp;form.tr.earliest=$tr.earliest$&amp;form.tr.latest=$tr.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>High (open)</title>
      <single>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search severity=high | search NOT status IN ("false_positive","remediated","resolved","closed","fixed") | stats dc(finding_key)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf1813f"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
        <drilldown>
          <link target="_blank">darkmoon_findings?form.sev=high&amp;form.tr.earliest=$tr.earliest$&amp;form.tr.latest=$tr.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>Confirmed</title>
      <single>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search status=confirmed | stats dc(finding_key)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0xdc4e41"]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Exploited</title>
      <single>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search status=exploited | stats dc(finding_key)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf1813f"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Operator-marked remediated share (%)</title>
      <single>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | stats count(eval(status=="remediated")) as rem dc(finding_key) as tot | eval pct=if(tot&gt;0, round(rem/tot*100,1), null()) | fields pct</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="unit">%</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0xdc4e41","0xf8be34","0x53a051"]</option>
        <option name="rangeValues">[40,75]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Latest reported retest comparisons</title>
      <chart>
        <search>
          <query>`darkmoon_index` sourcetype=darkmoon:retest verdict=* | dedup retest_id finding_key sortby -_indextime -_time | stats count by verdict</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.seriesColors">[0x53a051,0xdc4e41,0xf1813f,0x3b82f6]</option>
      </chart>
    </panel>
    <panel>
      <title>Status distribution</title>
      <chart>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | stats dc(finding_key) as count by status</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Findings over time (by severity)</title>
      <chart>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ event=finding.discovered | timechart count by severity</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.fieldColors">{"critical":0xdc4e41,"high":0xf1813f,"medium":0xf8be34,"low":0x53a051,"info":0x3b82f6,"informational":0x3b82f6}</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Severity distribution (open findings)</title>
      <chart>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search NOT status IN ("false_positive","remediated","resolved","closed","fixed") | stats dc(finding_key) as count by severity</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.fieldColors">{"count":0x3b82f6}</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Top exploited assets</title>
      <table>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | dedup finding_key sortby -_indextime -_time | search status=exploited | stats dc(finding_key) as exploited_findings values(severity) as severities latest(_time) as last_seen by target | eval last_seen=strftime(last_seen,"%F %T") | sort - exploited_findings</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">darkmoon_findings?form.target_tok=$row.target$&amp;form.tr.earliest=$tr.earliest$&amp;form.tr.latest=$tr.latest$</link>
        </drilldown>
      </table>
    </panel>
    <panel>
      <title>Active vs excluded finding observations</title>
      <chart>
        <search>
          <query>`darkmoon_findings` project_id=$proj|s$ | eval bucket=if(in(status,"false_positive","remediated","resolved","closed","fixed"),"excluded","active") | timechart dc(finding_key) by bucket</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.fieldColors">{"active":0xdc4e41,"excluded":0x8c8c8c}</option>
      </chart>
    </panel>
  </row>
</form>
