{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Darkmoon Security Posture",
  "id": "darkmoon-securityposture-app",
  "info": {
    "keywords": [
      "security",
      "pentest",
      "darkmoon",
      "vulnerabilities"
    ],
    "description": "Grafana app for the Darkmoon security platform. Bundles a backend datasource to visualize security posture: campaigns, findings, targets, time series and remediation pull requests. Sensitive evidence is never surfaced.",
    "author": {
      "name": "ASC-IT / Darkmoon"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Overview",
        "path": "img/screenshots/overview.png"
      },
      {
        "name": "Findings",
        "path": "img/screenshots/findings.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "datasource",
      "name": "Darkmoon Security Posture",
      "path": "datasource/plugin.json"
    },
    {
      "type": "page",
      "name": "Overview",
      "path": "/a/%PLUGIN_ID%/overview",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Campaigns",
      "path": "/a/%PLUGIN_ID%/campaigns",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Findings",
      "path": "/a/%PLUGIN_ID%/findings",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Targets",
      "path": "/a/%PLUGIN_ID%/targets",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Trends",
      "path": "/a/%PLUGIN_ID%/timeseries",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Published PRs",
      "path": "/a/%PLUGIN_ID%/pullrequests",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Local proposals",
      "path": "/a/%PLUGIN_ID%/remediation",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Retests",
      "path": "/a/%PLUGIN_ID%/retest",
      "addToNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "grafanaVersion": "10.4.x",
    "plugins": []
  }
}
