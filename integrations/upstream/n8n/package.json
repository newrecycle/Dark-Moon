{
	"name": "n8n-nodes-darkmoon",
	"version": "0.3.1",
	"description": "n8n community node + trigger for Darkmoon: launch AI pentest campaigns, read findings, run retests, review remediation pull requests, and react to Darkmoon events. Built on the shared @darkmoon_ai/client.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"darkmoon",
		"pentest",
		"security",
		"appsec",
		"dast",
		"soar",
		"vulnerability"
	],
	"license": "MIT",
	"homepage": "https://github.com/ASCIT31/darkmoon-n8n",
	"author": {
		"name": "ASC-IT / Darkmoon",
		"email": "contact@dark-moon.org",
		"url": "https://dark-moon.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ASCIT31/darkmoon-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/ASCIT31/darkmoon-n8n/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && node scripts/bundle.mjs && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"test": "npm run test:unit",
		"test:unit": "node test/unit.mjs"
	},
	"files": [
		"dist",
		"templates"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DarkmoonApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Darkmoon/Darkmoon.node.js",
			"dist/nodes/DarkmoonTrigger/DarkmoonTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@darkmoon_ai/client": "^0.2.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "^8.72.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"gulp": "^5.0.0",
		"n8n-workflow": "*",
		"prettier": "^3.3.2",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	}
}
