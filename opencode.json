{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nous": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "nous",
      "options": {
        "baseURL": "https://inference-api.nousresearch.com/v1",
        "includeUsage": true
      },
      "models": {
        "tencent/hy3:free": {
          "name": "tencent/hy3:free",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "meituan/longcat-2.0:free": {
          "name": "meituan/longcat-2.0:free",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "inferx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "inferx",
      "options": {
        "baseURL": "https://api.inferx.com/v1",
        "apiKey": "ix_84c30cde313ce341a76eda32bb6826e03c23b86f789d0db3931dfaec43fa8c5f",
        "includeUsage": true
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "qwen3.6-35b-a3b-fp8": {
          "name": "qwen3.6-35b-a3b-fp8",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "nous/meituan/longcat-2.0:free",
  "small_model": "nous/meituan/longcat-2.0:free",
  "mcp": {
    "darkmoon": {
      "type": "local",
      "command": [
        "/usr/local/bin/darkmoon-mcp"
      ],
      "timeout": 36000000,
      "enabled": true
    }
  },
  "permission": {
    "*": "allow"
  },
  "agent": {
    "pentest": {
      "model": "nous/meituan/longcat-2.0:free",
      "mode": "primary",
      "tools": {
        "darkmoon_get_session": true,
        "darkmoon_dashboard_init_campaign": true,
        "darkmoon_dashboard_finalize_campaign": true,
        "darkmoon_dashboard_push_infra_node": true,
        "darkmoon_dashboard_push_finding": true,
        "darkmoon_list_allowed_tools": true,
        "darkmoon_health_check": true,
        "darkmoon_execute_command": false
      },
      "permission": {
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "edit": "deny",
        "grep": "deny",
        "list": "deny",
        "task": "allow",
        "darkmoon_run_workflow": "deny",
        "darkmoon_execute_command": "deny",
        "external_directory": "allow"
      }
    },
    "aws": {
      "model": "inferx/qwen3.6-35b-a3b-fp8",
      "mode": "subagent",
      "tools": {
        "darkmoon_*": true
      },
      "permission": {
        "bash": "deny"
      },
      "retry": {
        "attempts": 5,
