FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DARKMOON_MCP_HOST=0.0.0.0 \
    DARKMOON_MCP_PORT=8000 \
    DARKMOON_MCP_PATH=/mcp

WORKDIR /opt/darkmoon/mcp/server

COPY mcp/requirements.lock ./requirements.lock
RUN python -m pip install \
      --no-cache-dir \
      --disable-pip-version-check \
      --requirement requirements.lock

COPY mcp/ ./

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=10s --start-period=10s --retries=12 \
  CMD ["python", "-m", "src.healthcheck"]

CMD ["python", "-m", "src.http_server"]
